# NodeMaven — one API key is enough (Profile → API key)
# The app calls GET /api/v2/base/users/me to get proxy_username + proxy_password for Puppeteer.
# Docs: https://dashboard.nodemaven.com/documentation/v2/swagger/

NODEMAVEN_API_KEY=your_api_key_here

# Optional: paste Proxy Setup credentials instead of using the API
# NODEMAVEN_PROXY_USER=your_proxy_username
# NODEMAVEN_PROXY_PASSWORD=your_proxy_password

# Production (KloudBean / VPS)
NODE_ENV=production
HOST=0.0.0.0

# Dashboard port (default 3942). Workspace ports — job-scraper 3847, google-search 3848, download 3939, hr-finding 3940, maps 3942
PORT=3942

# Optional: parallel scrape jobs (default 5)
# MAX_PARALLEL_JOBS=5

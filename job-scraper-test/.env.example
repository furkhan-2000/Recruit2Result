# NodeMaven — one API key is enough (Profile → API key)
# The app calls GET /api/v2/base/users/me to get proxy_username + proxy_password for Puppeteer.
# Docs: https://dashboard.nodemaven.com/documentation/v2/swagger/
#       https://docs.nodemaven.com/en/articles/10329935-api-access

NODEMAVEN_API_KEY=your_api_key_here

# Optional: paste Proxy Setup credentials instead of using the API (skip /users/me)
# NODEMAVEN_PROXY_USER=your_proxy_username
# NODEMAVEN_PROXY_PASSWORD=your_proxy_password

# AI Power-ups (OPTIONAL: App works without these using local keyword matching)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Safety & Robustness
SAFE_MODE_LOCAL=true # If true, slows down scraping on local IP to avoid blocks
MAX_CONCURRENT_BROWSERS=3

# Production (KloudBean / VPS)
NODE_ENV=production
HOST=0.0.0.0
PORT=3847
